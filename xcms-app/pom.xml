<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.df4j.xctec</groupId>
        <artifactId>xcms</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>xcms-app</artifactId>
    <packaging>jar</packaging>

    <name>xcms-app</name>
    <description>XCMS 应用装配模块（唯一 main，聚合 base/web 与各业务 impl）</description>

    <properties>
        <start-class>com.df4j.xctec.xcms.XcmsApplication</start-class>
    </properties>

    <dependencies>
        <!-- Web 适配层（含全局异常处理 / Jackson / 过滤器链 / 权限 AOP / SortResolver） -->
        <dependency>
            <groupId>com.df4j.xctec</groupId>
            <artifactId>xcms-web</artifactId>
        </dependency>
        <!-- 基础设施层（JPA / ID / 树 / 租户 / 事件 / 缓存 / 安全） -->
        <dependency>
            <groupId>com.df4j.xctec</groupId>
            <artifactId>xcms-base</artifactId>
        </dependency>

        <!-- 业务实现层（铁律：app 直接依赖各 impl，impl 之间互不依赖） -->
        <dependency>
            <groupId>com.df4j.xctec</groupId>
            <artifactId>xcms-system-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.df4j.xctec</groupId>
            <artifactId>xcms-auth-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.df4j.xctec</groupId>
            <artifactId>xcms-portal-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.df4j.xctec</groupId>
            <artifactId>xcms-audit-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.df4j.xctec</groupId>
            <artifactId>xcms-notify-impl</artifactId>
        </dependency>

        <!-- Spring Boot Web（内嵌容器 + Spring MVC） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JPA（@EnableJpaAuditing / 实体扫描） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-h2console</artifactId>
        </dependency>

        <!-- Lombok（编译期） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 可执行 jar 打包（xcms-app 是唯一 main） -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
