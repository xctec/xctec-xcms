<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <groupId>com.df4j.xctec</groupId>
    <artifactId>xcms-dependencies</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>xcms-dependencies</name>
    <description>XCMS 统一依赖管理 BOM（契约层版本真相源）</description>

    <properties>
        <revision>1.0.0-SNAPSHOT</revision>

        <!-- 第三方依赖版本（Spring 系由 spring-boot-starter-parent 管理） -->
        <!-- 注意：querydsl 必须用 querydsl-openfeign.version，不能用 querydsl.version，
             否则会与 spring-boot-dependencies BOM 中的 com.querydsl:querydsl-bom:5.1.0 冲突 -->
        <lombok.version>1.18.46</lombok.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <querydsl-openfeign.version>7.5</querydsl-openfeign.version>
        <transmittable-thread-local.version>2.14.5</transmittable-thread-local.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 本项目模块：统一版本为 ${revision} -->
            <dependency>
                <groupId>com.df4j.xctec</groupId>
                <artifactId>xcms-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec</groupId>
                <artifactId>xcms-base</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec</groupId>
                <artifactId>xcms-web</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec</groupId>
                <artifactId>xcms-system-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec</groupId>
                <artifactId>xcms-system-impl</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec</groupId>
                <artifactId>xcms-auth-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec</groupId>
                <artifactId>xcms-auth-impl</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec</groupId>
                <artifactId>xcms-portal-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec</groupId>
                <artifactId>xcms-portal-impl</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec</groupId>
                <artifactId>xcms-audit-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec</groupId>
                <artifactId>xcms-audit-impl</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec</groupId>
                <artifactId>xcms-notify-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.df4j.xctec</groupId>
                <artifactId>xcms-notify-impl</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- MapStruct -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

            <!-- QueryDSL（openfeign 版，原生 Jakarta） -->
            <dependency>
                <groupId>io.github.openfeign.querydsl</groupId>
                <artifactId>querydsl-jpa</artifactId>
                <version>${querydsl-openfeign.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.openfeign.querydsl</groupId>
                <artifactId>querydsl-apt</artifactId>
                <version>${querydsl-openfeign.version}</version>
                <classifier>jpa</classifier>
            </dependency>

            <!-- TransmittableThreadLocal -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>transmittable-thread-local</artifactId>
                <version>${transmittable-thread-local.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
